# LLM endpoint (OpenAI-compatible chat-completions).
# Copy this file to .env and fill in your local values. Real environment
# variables always override these values.
LLM_BASE_URL=http://HOST:1234/v1
LLM_API_KEY=
LLM_MODEL=MODEL_NAME
LLM_TIMEOUT=120
# LLM_ENABLE_THINKING=1

# Web-search MCP server consumed by the llm_bl research agent (stdio).
# Unset WEBSEARCH_MCP_COMMAND to disable the agent engine (falls back to direct).
WEBSEARCH_MCP_COMMAND=npx
WEBSEARCH_MCP_ARGS=-y dsh-google-chrome-search mcp
# CHROME_PATH=/usr/bin/google-chrome
# GSEARCH_PROFILE=/full/path/to/chrome-profile
